{
    "name": "spryker/security-blocker",
    "type": "library",
    "description": "SecurityBlocker module",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "spryker/container": "^1.10.0",
        "spryker/kernel": "^3.77.0",
        "spryker/log": "^3.17.0",
        "spryker/redis": "^2.15.0",
        "spryker/security-blocker-extension": "^1.1.0",
        "spryker/symfony": "^3.0.0",
        "spryker/transfer": "^3.27.0",
        "symfony/polyfill-intl-normalizer": "^1.0.0"
    },
    "require-dev": {
        "spryker/code-sniffer": "*",
        "spryker/monolog": "*",
        "spryker/testify": "*"
    },
    "autoload": {
        "psr-4": {
            "Spryker\\": "src/Spryker/",
            "SprykerTest\\Client\\SecurityBlocker\\Helper\\": "tests/SprykerTest/Client/SecurityBlocker/_support/Helper/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerTest\\": "tests/SprykerTest/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
