<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="SecurityCheckAuthContext">
        <property name="type" type="string"/>
        <property name="ip" type="string"/>
        <property name="account" type="string"/>
        <property name="realm" type="string"/>
        <property name="loginIdentifier" type="string"/>
        <property name="ipCounterKeyStrategy" type="string" description="Last part of the per-IP counter key: `ip` (default) uses `account`, `ip-and-username` the hash of the normalized `loginIdentifier`."/>
    </transfer>

    <transfer name="SecurityCheckAuthResponse">
        <property name="isBlocked" type="bool"/>
        <property name="numberOfAttempts" type="int"/>
        <property name="blockedFor" type="int"/>
        <property name="securityCheckAuthContext" type="SecurityCheckAuthContext"/>
        <property name="isChallengeRequired" type="bool"/>
    </transfer>

    <transfer name="SecurityCheckAttemptContext" strict="true">
        <property name="type" type="string"/>
        <property name="identifier" type="string"/>
        <property name="ttl" type="int"/>
    </transfer>

    <transfer name="SecurityCheckAttemptResponse" strict="true">
        <property name="numberOfAttempts" type="int"/>
    </transfer>

    <transfer name="SecurityBlockerConfigurationSettings">
        <property name="numberOfAttempts" type="int"/>
        <property name="ttl" type="int"/>
        <property name="blockFor" type="int"/>
    </transfer>

    <transfer name="SecurityBlockerLoginRealmConfiguration" strict="true">
        <property name="realm" type="string"/>
        <property name="accountNumberOfAttempts" type="int"/>
        <property name="accountTtl" type="int"/>
        <property name="accountBlockFor" type="int"/>
        <property name="accountChallengeNumberOfAttempts" type="int"/>
        <property name="ipChallengeNumberOfAttempts" type="int"/>
        <property name="globalChallengeNumberOfAttempts" type="int"/>
        <property name="globalTtl" type="int"/>
    </transfer>

    <transfer name="AuditLoggerConfigCriteria" strict="true">
        <property name="channelName" type="string"/>
    </transfer>

    <transfer name="RedisConfiguration">
        <property name="dataSourceNames" type="array" singular="dataSourceNames"/>
        <property name="connectionCredentials" type="RedisCredentials"/>
        <property name="clientOptions" type="array" singular="clientOption" associative="true"/>
    </transfer>

    <transfer name="RedisCredentials">
        <property name="protocol" type="string" deprecated="Use scheme property instead"/>
        <property name="scheme" type="string"/>
        <property name="host" type="string"/>
        <property name="port" type="string"/>
        <property name="password" type="string"/>
        <property name="database" type="int"/>
        <property name="isPersistent" type="bool"/>
        <property name="username" type="string"/>
    </transfer>

</transfers>
